{
  "manifest_version": 3,
  "name": "自影 AutoReel · 自动成片与多平台发布",
  "version": "2.1.0",
  "description": "从你的 GitHub 仓库取每期成品，自动发布到抖音、视频号、快手；扫码登录、登录保活、验证提醒、模板化消息推送。",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "tabs",
    "debugger",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://api.github.com/*",
    "https://raw.githubusercontent.com/*",
    "https://*.douyin.com/*",
    "https://channels.weixin.qq.com/*",
    "https://*.kuaishou.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://creator.douyin.com/*"
      ],
      "js": [
        "content/common.js",
        "content/douyin.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://channels.weixin.qq.com/*"
      ],
      "js": [
        "content/common.js",
        "content/channels.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://cp.kuaishou.com/*",
        "https://passport.kuaishou.com/*"
      ],
      "js": [
        "content/common.js",
        "content/kuaishou.js"
      ],
      "run_at": "document_idle"
    }
  ]
}