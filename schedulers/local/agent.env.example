# 复制成 agent.env（已在 .gitignore 里，不会提交），按你的 AI 工具取消注释一组。写法以各工具官方文档为准。
AGENT_CMD='claude -p "$PROMPT" --dangerously-skip-permissions'
# AGENT_CMD='codex exec --dangerously-bypass-approvals-and-sandbox "$PROMPT"'
# AGENT_CMD='gemini --yolo -p "$PROMPT"'
# AGENT_CMD='opencode run "$PROMPT"'

# AI 工具的 API 密钥（已经在命令行登录过的工具可以不填）
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# 可选：实拍素材、通知里引用的变量
# PEXELS_API_KEY=
# PIXABAY_API_KEY=
# WECOM_KEY=
